    {
      "id": "n_graphify_tests_test_src_layout_import_resolution_rationale_1",
      "type": "file",
      "file": "2072 Python import resolution must not depend on the scan root. A src-layout\u2026.md",
      "x": 4280,
      "y": 80,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_graphify_tests_test_resolve_memoization_rationale_65",
      "type": "file",
      "file": "A path that resolve() can handle returns the same as a direct call; the helper\u2026.md",
      "x": 4480,
      "y": 80,
      "width": 180,
      "height": 60
